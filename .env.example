# ── Firewall (PAN-OS) ────────────────────────────────────────────────────────
# A reachable firewall with a read-only API admin role. Not needed in Demo mode.
PANOS_HOST=ip
PANOS_API_KEY=replace-me
PANOS_VSYS=vsys1

# ── RAG (Voyage AI) ──────────────────────────────────────────────────────────
# Embeddings + rerank for the prerequisite stage's doc retrieval. Not needed in
# Demo mode (the UI uses a canned retriever there).
VOYAGE_API_KEY=replace-me

# ── LLM: Anthropic + optional Portkey gateway ────────────────────────────────
# Direct Anthropic key. Required unless you use Portkey Cloud with a virtual key.
ANTHROPIC_API_KEY=replace-me
# Anthropic model id for direct / self-hosted-gateway calls.
# MODEL=claude-opus-4-8

# How model calls are routed:
#   off          direct to Anthropic (default) — no gateway, no AIRS scanning
#   self_hosted  local OSS Portkey gateway (Docker, console at :8787)
#   cloud        Portkey Cloud (https://api.portkey.ai)
PORTKEY_MODE=off
# Portkey API key (self_hosted / cloud).
PORTKEY_API_KEY=
# Portkey Config ID (pc-***) whose input/output guardrails run Prisma AIRS.
# Prisma AIRS is configured entirely in the Portkey GUI — no AIRS keys live here.
PORTKEY_CONFIG=
# Cloud only: model catalog slug (@<provider>/<model>).
PORTKEY_MODEL=@anthropic/claude-opus-4-8
# Cloud only: virtual key (vault-backed provider credential). Optional.
PORTKEY_VIRTUAL_KEY=
# self_hosted only: base URL of the local OSS gateway.
PORTKEY_SELF_HOSTED_URL=http://localhost:8787/v1
# Optional: route the agent's MCP tool calls through the Portkey MCP gateway so
# they're logged there. Needs pan-os-mcp exposed over HTTP and registered in
# Portkey. Leave empty to use the local stdio server.
PORTKEY_MCP_URL=
# e.g. PORTKEY_MCP_URL=https://mcp.portkey.ai/pan-os-mcp/mcp
