PANOS_HOST=ip
PANOS_API_KEY=replace-me
PANOS_VSYS=vsys1
VOYAGE_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me

# Secured product only. Prisma AIRS is configured in the Portkey GUI
# (Guardrails) and attached to the Config below — no AIRS keys live here.
PORTKEY_API_KEY=replace-me
PORTKEY_MODEL=@anthropic/claude-opus-4-8
PORTKEY_CONFIG=pc-replace-me
# Optional: route the secured agent's MCP tool calls through the Portkey MCP
# gateway so they're logged there. Needs the pan-os-mcp server exposed over HTTP
# and registered in Portkey. Leave empty to use the local stdio server.
PORTKEY_MCP_URL=
# e.g. PORTKEY_MCP_URL=https://mcp.portkey.ai/pan-os-mcp/mcp